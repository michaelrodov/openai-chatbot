# ====================
# Provider Configuration
# ====================
# Choose your LLM provider: "OpenAI" or "AzureOpenAI"
PROVIDER=OpenAI

# ====================
# OpenAI Configuration
# ====================
# Your OpenAI API key - get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Your OpenAI organization ID (optional)
OPENAI_ORG_ID=org-your-org-id-here

# Your OpenAI project ID (optional)
OPENAI_PROJECT_ID=proj-your-project-id-here

# The OpenAI model to use (e.g., gpt-4, gpt-3.5-turbo, gpt-4-turbo)
OPENAI_MODEL=gpt-4

# Optional: If you need to override the OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# ====================
# Azure OpenAI Configuration
# ====================
# Azure OpenAI API Version (e.g., 2024-04-01-preview)
AZUREOPENAI_VERSION=2024-04-01-preview

# Your Azure OpenAI API key from Azure Portal
AZUREOPENAI_API_KEY=your-azure-openai-api-key-here

# Your Azure OpenAI endpoint (e.g., https://your-resource.cognitiveservices.azure.com/)
AZUREOPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# The model name (e.g., gpt-4, gpt-35-turbo, gpt-4-turbo)
AZUREOPENAI_MODEL=gpt-4

# The deployment name you created in Azure AI Studio
AZUREOPENAI_DEPLOYMENT=your-deployment-name

# ====================
# Anthropic Configuration
# ====================
# Your Anthropic API key - get it from https://console.anthropic.com/
CHATBOT_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# The Anthropic model to use (e.g., claude-3-5-sonnet-20241022, claude-3-opus-20240229)
CHATBOT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Target URL for Anthropic LLM requests via AI Firewall
ANTHROPIC_LLM_PROVIDER_TARGET_URL=https://api.anthropic.com

# ====================
# AWS Bedrock Configuration
# ====================
# AWS region for Bedrock (e.g., us-east-1, eu-central-1)
BEDROCK_AWS_REGION=us-east-1

# AWS Access Key ID for Bedrock
BEDROCK_AWS_ACCESS_ID_KEY=your-aws-access-key-id-here

# AWS Secret Access Key for Bedrock
BEDROCK_AWS_SECRET_ID_KEY=your-aws-secret-access-key-here

# Bedrock model ID for Claude (e.g., anthropic.claude-3-haiku-20240307-v1:0, anthropic.claude-3-sonnet-20240229-v1:0)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Target URL for Bedrock LLM requests via AI Firewall
BEDROCK_LLM_PROVIDER_TARGET_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# ====================
# Google Gemini Configuration
# ====================
# Your Google Gemini API key - get it from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# The Gemini model to use (e.g., gemini-pro, gemini-1.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-pro

# ====================
# Cohere Configuration
# ====================
# Your Cohere API key - get it from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# The Cohere model to use (e.g., command, command-light, command-r, command-r-plus)
COHERE_MODEL=command

# ====================
# Grok/xAI Configuration
# ====================
# Your Grok API key - get it from https://console.x.ai/
GROK_API_KEY=your-grok-api-key-here

# The Grok model to use (e.g., grok-beta, grok-1)
GROK_MODEL=grok-beta

# ====================
# AI Firewall Configuration
# ====================
# The base URL for your AI Firewall gateway
# Example: https://your-aifw-gateway.com or http://localhost:8080
AIFW_GATEWAY_URL=https://your-aifw-gateway.com

# Your AI Firewall API key for authentication
AIFW_API_KEY=imp-your-aifw-api-key-here

# ====================
# Usage Notes
# ====================
# 1. Copy this file to create environment-specific configs:
#    - .env (for default dev)
#    - .env.openai (for standard OpenAI)
#    - .env.azure.openai (for Azure OpenAI)
#
# 2. Replace placeholder values with your actual credentials
#
# 3. Never commit actual .env files with real credentials to version control
#
# 4. Use the appropriate npm script from package.json:
#    - npm run openai (uses .env.openai on port 3300)
#    - npm run azure:openai (uses .env.azure.openai on port 3301)
#    - npm run dev (uses .env on port 3300)
